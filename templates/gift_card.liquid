{% layout none %}

<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% render 'meta-tags' %}
    {% render 'css-variables' %}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>

  <body class="template-gift-card">
    <main class="gift-card page-width">
      {%- if settings.logo -%}
        {{ settings.logo | image_url: width: 300 | image_tag: alt: shop.name, class: 'gift-card__logo' }}
      {%- else -%}
        <p class="h3">{{ shop.name }}</p>
      {%- endif -%}

      <h1 class="h1">{{ gift_card.balance | money }}</h1>

      {%- if gift_card.enabled == false or gift_card.expired -%}
        <p class="form-message form-message--error">{{ 'gift_card.expired' | t }}</p>
      {%- endif -%}

      {%- if gift_card.expires_on -%}
        {%- assign expires_on = gift_card.expires_on | date: '%B %e, %Y' -%}
        <p>{{ 'gift_card.expires_on' | t: expires_on: expires_on }}</p>
      {%- endif -%}

      <p class="eyebrow">{{ 'gift_card.use_at_checkout' | t }}</p>
      <p class="gift-card__code">{{ gift_card.code | format_code }}</p>

      {%- if gift_card.pass_url -%}
        <a href="{{ gift_card.pass_url }}">
          <img
            src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}"
            alt="{{ 'gift_card.add_to_apple_wallet' | t }}"
            width="200"
            height="60"
          >
        </a>
      {%- endif -%}

      <a class="button" href="{{ shop.url }}">{{ 'gift_card.shop' | t }}</a>
    </main>
  </body>
</html>
