{% layout 'password' %}

<section class="password page-width">
  {%- if settings.logo -%}
    {{ settings.logo | image_url: width: 400 | image_tag: class: 'password__logo', alt: shop.name, loading: 'eager' }}
  {%- else -%}
    <h1 class="h1">{{ shop.name }}</h1>
  {%- endif -%}

  {%- if shop.password_message != blank -%}
    <p class="password__message">{{ shop.password_message }}</p>
  {%- endif -%}

  {%- form 'customer', class: 'newsletter-form' -%}
    <input type="hidden" name="contact[tags]" value="newsletter">
    {%- if form.posted_successfully? -%}
      <p class="form-message">{{ 'newsletter.success' | t }}</p>
    {%- else -%}
      <div class="newsletter-form__field">
        <label class="visually-hidden" for="PasswordNewsletter">{{ 'newsletter.email' | t }}</label>
        <input id="PasswordNewsletter" type="email" name="contact[email]" placeholder="{{ 'newsletter.email' | t }}" autocomplete="email" required>
        <button type="submit" class="button">{{ 'newsletter.submit' | t }}</button>
      </div>
    {%- endif -%}
  {%- endform -%}

  <details class="password__login">
    <summary class="text-link">{{ 'password.title' | t }}</summary>
    {%- form 'storefront_password' -%}
      {%- if form.errors -%}
        <p class="form-message form-message--error">{{ form.errors.messages['form'] }}</p>
      {%- endif -%}
      <div class="newsletter-form__field">
        <label class="visually-hidden" for="PasswordInput">{{ 'password.password' | t }}</label>
        <input type="password" name="password" id="PasswordInput" placeholder="{{ 'password.password' | t }}" autocomplete="current-password">
        <button type="submit" class="button">{{ 'password.enter' | t }}</button>
      </div>
    {%- endform -%}
  </details>
</section>
