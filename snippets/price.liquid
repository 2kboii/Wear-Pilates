{% doc %}
  Renders a price, with compare-at price when on sale.

  @param {object} target - A product or variant
  @param {boolean} [show_from] - Prefix "From" when variant prices differ
{% enddoc %}
{%- liquid
  if target.object_type == 'product'
    assign price = target.price
    assign compare = target.compare_at_price
    assign varies = target.price_varies
  else
    assign price = target.price
    assign compare = target.compare_at_price
    assign varies = false
  endif
  assign on_sale = false
  if compare > price
    assign on_sale = true
  endif
-%}
<span class="price{% if on_sale %} price--sale{% endif %}">
  {%- if show_from and varies -%}
    <span class="price__from">{{ 'products.from' | t }}</span>
  {%- endif -%}
  <span class="price__current">{{ price | money }}</span>
  {%- if on_sale -%}
    <s class="price__compare"><span class="visually-hidden">{{ 'products.regular_price' | t }}</span>{{ compare | money }}</s>
  {%- endif -%}
</span>
