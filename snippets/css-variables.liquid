{%- liquid
  assign heading_bold = settings.type_heading_font | font_modify: 'weight', 'bolder'
  assign body_medium = settings.type_body_font | font_modify: 'weight', '+100'
  assign body_bold = settings.type_body_font | font_modify: 'weight', 'bold'
  assign body_italic = settings.type_body_font | font_modify: 'style', 'italic'
-%}
{% style %}
  {{ settings.type_heading_font | font_face: font_display: 'swap' }}
  {{ heading_bold | font_face: font_display: 'swap' }}
  {{ settings.type_body_font | font_face: font_display: 'swap' }}
  {{ body_medium | font_face: font_display: 'swap' }}
  {{ body_bold | font_face: font_display: 'swap' }}
  {{ body_italic | font_face: font_display: 'swap' }}

  :root {
    --font-heading: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
    --font-heading-weight: {{ settings.type_heading_font.weight }};
    --font-heading-bold: {{ heading_bold.weight | default: 700 }};
    --font-body: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    --font-body-weight: {{ settings.type_body_font.weight }};
    --font-body-medium: {{ body_medium.weight | default: 500 }};

    --color-bg: {{ settings.color_background }};
    --color-fg: {{ settings.color_foreground }};
    --color-muted: {{ settings.color_muted }};
    --color-panel: {{ settings.color_panel }};
    --color-accent: {{ settings.color_accent }};
    --color-border: {{ settings.color_border }};

    --page-width: {{ settings.page_width }}px;
    --page-margin: {{ settings.page_margin }}px;
    --logo-height: {{ settings.logo_height }}px;
    --card-ratio: {{ settings.card_image_ratio }};
  }
{% endstyle %}
