  {%- when 'tiktok' -%}
    <svg class="icon" aria-hidden="true" focusable="false" viewBox="0 0 20 20" fill="currentColor"><path d="M14.2 2h-2.9v11.4a2.5 2.5 0 1 1-2.5-2.5c.3 0 .5 0 .7.1V8.1a5.4 5.4 0 1 0 4.7 5.3V7.6a6.9 6.9 0 0 0 3.8 1.2V5.9a3.9 3.9 0 0 1-3.8-3.9Z"/></svg>
  {%- when 'facebook' -%}
    <svg class="icon" aria-hidden="true" focusable="false" viewBox="0 0 20 20" fill="currentColor"><path d="M11.3 18v-7h2.3l.4-2.8h-2.7V6.5c0-.8.2-1.3 1.4-1.3H14V2.7A19 19 0 0 0 11.9 2.6c-2.1 0-3.5 1.3-3.5 3.6v2H6v2.8h2.4v7h2.9Z"/></svg>
{%- endcase -%}
