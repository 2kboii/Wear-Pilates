<article class="article page-width page-width--narrow">
  <header class="article__header">
    <p class="eyebrow">{{ article.published_at | time_tag: format: 'date' }}</p>
    <h1 class="h1">{{ article.title | escape }}</h1>
  </header>
  {%- if article.image -%}
    <div class="article__image">
      {{ article.image | image_url: width: 1600 | image_tag: sizes: '(min-width: 900px) 860px, 100vw', widths: '500,800,1200,1600', loading: 'eager' }}
    </div>
  {%- endif -%}
  <div class="rte">{{ article.content }}</div>
  <p><a class="text-link" href="{{ blog.url }}">{{ 'blog.back' | t }}</a></p>
</article>

{% schema %}
{
  "name": "Article",
  "settings": []
}
{% endschema %}
