<section
  class="product-recommendations page-width section-spacing"
  data-recommendations
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent={{ section.settings.intent }}"
>
  {%- if recommendations.performed? and recommendations.products_count > 0 -%}
    <div class="section-intro section-intro--center">
      <h2 class="h2">{{ section.settings.heading | escape }}</h2>
    </div>
    <ul class="product-grid" style="--columns: {{ section.settings.limit }};">
      {%- for rec in recommendations.products -%}
        <li>{% render 'product-card', product: rec %}</li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Product recommendations",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Complete the look" },
    {
      "type": "select",
      "id": "intent",
      "label": "Type",
      "options": [
        { "value": "related", "label": "Related" },
        { "value": "complementary", "label": "Complementary (set in Search & Discovery app)" }
      ],
      "default": "related"
    },
    { "type": "range", "id": "limit", "min": 2, "max": 6, "step": 1, "label": "Products", "default": 4 }
  ]
}
{% endschema %}
