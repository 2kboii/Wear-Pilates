<section class="collection page-width">
  <div class="collection__header">
    <h1 class="h1">{{ collection.title | escape }}</h1>
    {%- if section.settings.show_description and collection.description != blank -%}
      <div class="collection__description rte">{{ collection.description }}</div>
    {%- endif -%}
  </div>

  {%- paginate collection.products by section.settings.per_page -%}
    {% render 'facets', results: collection %}

    {%- if collection.products.size > 0 -%}
      <ul class="product-grid product-grid--collection" style="--columns: {{ section.settings.columns }};">
        {%- for product in collection.products -%}
          {%- liquid
            assign eager = false
            if forloop.index <= 4
              assign eager = true
            endif
          -%}
          <li>{% render 'product-card', product: product, eager: eager %}</li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <div class="empty-state">
        <p>{{ 'collections.empty' | t }}</p>
        <a class="text-link" href="{{ collection.url }}">{{ 'collections.clear_all' | t }}</a>
      </div>
    {%- endif -%}

    {% render 'pagination', paginate: paginate %}
  {%- endpaginate -%}
</section>

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "checkbox", "id": "show_description", "label": "Show collection description", "default": true },
    { "type": "range", "id": "per_page", "min": 8, "max": 48, "step": 4, "label": "Products per page", "default": 24 },
    { "type": "range", "id": "columns", "min": 2, "max": 5, "step": 1, "label": "Columns on desktop", "default": 4 }
  ]
}
{% endschema %}
