<section class="blog page-width">
  <h1 class="h1">{{ blog.title | escape }}</h1>
  {%- paginate blog.articles by 12 -%}
    <ul class="blog__grid">
      {%- for article in blog.articles -%}
        <li>
          <article class="article-card">
            <a class="article-card__media" href="{{ article.url }}" tabindex="-1" aria-hidden="true">
              {%- if article.image -%}
                {{ article.image | image_url: width: 900 | image_tag: sizes: '(min-width: 750px) 33vw, 100vw', widths: '400,600,900', loading: 'lazy' }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}
              {%- endif -%}
            </a>
            <p class="eyebrow">{{ article.published_at | time_tag: format: 'date' }}</p>
            <h2 class="card__title"><a href="{{ article.url }}">{{ article.title | escape }}</a></h2>
            <p class="article-card__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 26 }}</p>
          </article>
        </li>
      {%- endfor -%}
    </ul>
    {% render 'pagination', paginate: paginate %}
  {%- endpaginate -%}
</section>

{% schema %}
{
  "name": "Blog",
  "settings": []
}
{% endschema %}
