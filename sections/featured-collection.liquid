{%- assign collection = section.settings.collection -%}
<section class="featured-collection page-width section-spacing" data-carousel>
  {%- if section.settings.heading != blank or section.settings.text != blank -%}
    <div class="section-intro section-intro--{{ section.settings.align }}">
      {%- if section.settings.heading != blank -%}
        <h2 class="h2">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="section-intro__text">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if section.settings.layout == 'carousel' -%}
    <div class="carousel__controls">
      {%- if collection != blank and section.settings.show_view_all -%}
        <a class="text-link" href="{{ collection.url }}">{{ 'general.view_all' | t }}</a>
      {%- endif -%}
      <button type="button" class="carousel__arrow" data-carousel-prev aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'chevron-left' %}</button>
      <button type="button" class="carousel__arrow" data-carousel-next aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'chevron-right' %}</button>
    </div>
  {%- endif -%}

  <ul class="{% if section.settings.layout == 'carousel' %}carousel{% else %}product-grid{% endif %}" style="--columns: {{ section.settings.columns }};" data-carousel-track>
    {%- if collection != blank and collection.products_count > 0 -%}
      {%- for product in collection.products limit: section.settings.limit -%}
        <li class="carousel__item">{% render 'product-card', product: product, sizes: '(min-width: 990px) 17vw, 45vw' %}</li>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..6) -%}
        <li class="carousel__item">
          <div class="card">
            <div class="card__media">{{ 'product-apparel-1' | placeholder_svg_tag: 'card__placeholder' }}</div>
            <div class="card__info"><p class="card__title">{{ 'general.product_title' | t }}</p></div>
          </div>
        </li>
      {%- endfor -%}
    {%- endif -%}
  </ul>

  {%- if section.settings.layout == 'grid' and collection != blank and section.settings.show_view_all -%}
    <div class="section-footer-link"><a class="text-link" href="{{ collection.url }}">{{ 'general.view_all' | t }}</a></div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Heritage Edit" },
    { "type": "richtext", "id": "text", "label": "Text" },
    {
      "type": "select",
      "id": "align",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "min": 2, "max": 24, "step": 1, "label": "Products to show", "default": 12 },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "carousel", "label": "Carousel" },
        { "value": "grid", "label": "Grid" }
      ],
      "default": "carousel"
    },
    { "type": "range", "id": "columns", "min": 2, "max": 6, "step": 1, "label": "Columns on desktop", "default": 6 },
    { "type": "checkbox", "id": "show_view_all", "label": "Show 'View all' link", "default": true }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
