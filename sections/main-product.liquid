{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign color_names = settings.swatch_option_names | downcase | split: ','
  assign form_id = 'ProductForm-' | append: section.id
-%}
<section class="product page-width" data-product data-section-id="{{ section.id }}">
  <div class="product__gallery" data-product-gallery>
    <ul class="product__media-list">
      {%- for media in product.media -%}
        <li class="product__media" data-media-id="{{ media.id }}">
          {%- case media.media_type -%}
            {%- when 'image' -%}
              {%- liquid
                assign loading = 'lazy'
                if forloop.first
                  assign loading = 'eager'
                endif
              -%}
              {{ media | image_url: width: 1600 | image_tag: sizes: '(min-width: 990px) 30vw, 90vw', widths: '400,600,800,1000,1300,1600', loading: loading, alt: media.alt | default: product.title }}
            {%- when 'video' -%}
              {{ media | video_tag: controls: true, playsinline: true, image_size: '1200x' }}
            {%- when 'external_video' -%}
              {{ media | external_video_tag }}
            {%- else -%}
              {{ media | media_tag }}
          {%- endcase -%}
        </li>
      {%- else -%}
        <li class="product__media">{{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder' }}</li>
      {%- endfor -%}
    </ul>
    {%- if product.media.size > 1 -%}
      <p class="product__media-counter" aria-hidden="true"><span data-media-index>1</span> / {{ product.media.size }}</p>
    {%- endif -%}
  </div>

  <div class="product__info">
    <div class="product__info-inner">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            <div class="product__block">{% render block %}</div>

          {%- when 'title' -%}
            <div class="product__block" {{ block.shopify_attributes }}>
              {%- if block.settings.show_type and product.type != blank -%}
                <p class="eyebrow">{{ product.type }}</p>
              {%- endif -%}
              <h1 class="product__title">{{ product.title | escape }}</h1>
            </div>

          {%- when 'price' -%}
            <div class="product__block product__price" {{ block.shopify_attributes }} data-product-price>
              {% render 'price', target: current_variant %}
            </div>

          {%- when 'variant_picker' -%}
            {%- unless product.has_only_default_variant -%}
              <div class="product__block variant-picker" {{ block.shopify_attributes }} data-variant-picker>
                {%- for option in product.options_with_values -%}
                  {%- liquid
                    assign option_key = option.name | downcase | strip
                    assign is_color = false
                    for n in color_names
                      assign n_key = n | strip
                      if option_key == n_key
                        assign is_color = true
                      endif
                    endfor
                  -%}
                  <fieldset class="variant-picker__option" data-option-index="{{ forloop.index0 }}">
                    <legend class="variant-picker__legend">
                      {{ option.name | escape }}: <span data-option-selected>{{ option.selected_value | escape }}</span>
                    </legend>
                    <div class="variant-picker__values{% if is_color %} variant-picker__values--color{% endif %}">
                      {%- for value in option.values -%}
                        {%- assign input_id = section.id | append: '-' | append: forloop.parentloop.index0 | append: '-' | append: forloop.index0 -%}
                        {%- assign swatch = '' -%}
                        {%- if is_color -%}
                          {%- capture swatch -%}{% render 'swatch-color', value: value %}{%- endcapture -%}
                          {%- assign swatch = swatch | strip -%}
                        {%- endif -%}
                        <input
                          class="visually-hidden"
                          type="radio"
                          id="{{ input_id }}"
                          name="{{ option.name | escape }}-{{ section.id }}"
                          value="{{ value.name | escape }}"
                          {% if value.selected %}checked{% endif %}
                          data-option-value
                        >
                        <label
                          for="{{ input_id }}"
                          class="{% if is_color %}swatch swatch--large{% if swatch == blank %} swatch--unknown{% endif %}{% else %}pill{% endif %}{% unless value.available %} is-unavailable{% endunless %}"
                          title="{{ value.name | escape }}"
                          {% if is_color and swatch != blank %}
                            style="--swatch: {{ swatch }};"
                          {% endif %}
                        >
                          {%- if is_color -%}
                            <span class="visually-hidden">{{ value.name | escape }}</span>
                          {%- else -%}
                            {{ value.name | escape }}
                          {%- endif -%}
                        </label>
                      {%- endfor -%}
                    </div>
                  </fieldset>
                {%- endfor -%}
                <script type="application/json" data-product-json>
                  {{ product | json }}
                </script>
              </div>
            {%- endunless -%}

          {%- when 'size_guide' -%}
            {%- assign guide = block.settings.page -%}
            {%- if guide != blank -%}
              <details class="product__block size-guide" {{ block.shopify_attributes }}>
                <summary class="text-link">{{ block.settings.label | escape }}</summary>
                <div class="size-guide__content rte">{{ guide.content }}</div>
              </details>
            {%- endif -%}

          {%- when 'buy_buttons' -%}
            <div class="product__block" {{ block.shopify_attributes }}>
              {%- form 'product', product, id: form_id, class: 'product-form' -%}
                <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
                {%- if block.settings.show_quantity -%}
                  <div class="qty qty--input">
                    <label class="visually-hidden" for="Quantity-{{ section.id }}">{{ 'cart.quantity' | t }}</label>
                    <input id="Quantity-{{ section.id }}" type="number" name="quantity" value="1" min="1" inputmode="numeric">
                  </div>
                {%- endif -%}
                <button
                  type="submit"
                  name="add"
                  class="button button--full"
                  data-add-to-cart
                  {% unless current_variant.available %}disabled{% endunless %}
                >
                  <span data-add-to-cart-text>
                    {%- if current_variant.available -%}
                      {{ 'products.add_to_cart' | t }}
                    {%- else -%}
                      {{ 'products.sold_out' | t }}
                    {%- endif -%}
                  </span>
                </button>
                <p class="form-message form-message--error" role="alert" data-product-error hidden></p>
                {%- if block.settings.show_dynamic_checkout -%}
                  <div data-dynamic-checkout{% unless current_variant.available %} hidden{% endunless %}>
                    {{ form | payment_button }}
                  </div>
                {%- endif -%}
              {%- endform -%}
            </div>

          {%- when 'trust' -%}
            <ul class="product__block product-trust" {{ block.shopify_attributes }}>
              {%- if block.settings.line_1 != blank -%}
                <li>{% render 'icon', name: 'print' %}<span>{{ block.settings.line_1 }}</span></li>
              {%- endif -%}
              {%- if block.settings.line_2 != blank -%}
                <li>{% render 'icon', name: 'truck' %}<span>{{ block.settings.line_2 }}</span></li>
              {%- endif -%}
              {%- if block.settings.line_3 != blank -%}
                <li>{% render 'icon', name: 'return' %}<span>{{ block.settings.line_3 }}</span></li>
              {%- endif -%}
            </ul>

          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <details class="product__block accordion" {{ block.shopify_attributes }}{% if block.settings.open %} open{% endif %}>
                <summary class="accordion__summary">{{ block.settings.heading | escape }}{% render 'icon', name: 'plus' %}</summary>
                <div class="accordion__content rte">{{ product.description }}</div>
              </details>
            {%- endif -%}

          {%- when 'collapsible' -%}
            {%- liquid
              assign body = block.settings.content
              if block.settings.page != blank
                assign body = block.settings.page.content
              endif
            -%}
            {%- if body != blank -%}
              <details class="product__block accordion" {{ block.shopify_attributes }}>
                <summary class="accordion__summary">{{ block.settings.heading | escape }}{% render 'icon', name: 'plus' %}</summary>
                <div class="accordion__content rte">{{ body }}</div>
              </details>
            {%- endif -%}

          {%- when 'text' -%}
            <div class="product__block rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product",
  "class": "section-main-product",
  "blocks": [
    { "type": "@app" },
    {
      "type": "title",
      "name": "Title",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_type", "label": "Show product type", "default": false }
      ]
    },
    { "type": "price", "name": "Price", "limit": 1, "settings": [] },
    { "type": "variant_picker", "name": "Variant picker", "limit": 1, "settings": [] },
    {
      "type": "size_guide",
      "name": "Size guide",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Size guide" },
        { "type": "page", "id": "page", "label": "Page with the size chart" }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_quantity", "label": "Show quantity selector", "default": false },
        { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show dynamic checkout buttons", "default": true }
      ]
    },
    {
      "type": "trust",
      "name": "Trust lines",
      "limit": 1,
      "settings": [
        { "type": "inline_richtext", "id": "line_1", "label": "Line 1", "default": "Printed to order, just for you" },
        { "type": "inline_richtext", "id": "line_2", "label": "Line 2", "default": "See our <a href=\"/pages/shipping-policy\">shipping policy</a>" },
        { "type": "inline_richtext", "id": "line_3", "label": "Line 3", "default": "<a href=\"/pages/returns-refunds\">Returns & refunds</a>" }
      ]
    },
    {
      "type": "description",
      "name": "Description",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Description" },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": true }
      ]
    },
    {
      "type": "collapsible",
      "name": "Collapsible tab",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shipping & returns" },
        { "type": "richtext", "id": "content", "label": "Content" },
        { "type": "page", "id": "page", "label": "Or show a page's content" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Text</p>" }
      ]
    }
  ]
}
{% endschema %}
