<section class="promo-panels page-width section-spacing">
  {%- for block in section.blocks -%}
    <div class="promo" {{ block.shopify_attributes }}>
      <a class="promo__small" href="{{ block.settings.link | default: '#' }}">
        <span class="promo__label">{{ block.settings.label | escape }}</span>
        <span class="promo__small-media">
          {%- if block.settings.image_small -%}
            {{ block.settings.image_small | image_url: width: 900 | image_tag: sizes: '(min-width: 990px) 22vw, 45vw', widths: '300,450,600,900', loading: 'lazy' }}
          {%- else -%}
            {{ 'product-apparel-2' | placeholder_svg_tag: 'placeholder' }}
          {%- endif -%}
        </span>
        {%- if block.settings.caption != blank -%}
          <span class="promo__caption">{{ block.settings.caption | escape }}</span>
        {%- endif -%}
      </a>
      <a class="promo__large" href="{{ block.settings.link | default: '#' }}" tabindex="-1" aria-hidden="true">
        {%- if block.settings.image_large -%}
          {{ block.settings.image_large | image_url: width: 1400 | image_tag: sizes: '(min-width: 990px) 28vw, 55vw', widths: '400,600,900,1200,1400', loading: 'lazy' }}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder' }}
        {%- endif -%}
      </a>
    </div>
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "Promo panels",
  "max_blocks": 2,
  "settings": [],
  "blocks": [
    {
      "type": "panel",
      "name": "Panel",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Shop the edit" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "image_picker", "id": "image_small", "label": "Product image (cut-out on light background works best)" },
        { "type": "text", "id": "caption", "label": "Caption", "default": "Made for the studio, worn everywhere after." },
        { "type": "image_picker", "id": "image_large", "label": "Lifestyle image" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Promo panels",
      "blocks": [{ "type": "panel" }, { "type": "panel" }]
    }
  ]
}
{% endschema %}
