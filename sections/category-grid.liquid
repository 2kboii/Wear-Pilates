<section class="category-grid page-width section-spacing">
  {%- if section.settings.heading != blank -%}
    <div class="section-intro section-intro--center">
      <h2 class="eyebrow eyebrow--rule">{{ section.settings.heading | escape }}</h2>
    </div>
  {%- endif -%}

  <ul class="category-grid__list" style="--columns: {{ section.settings.columns }};">
    {%- for block in section.blocks -%}
      {%- liquid
        assign c = block.settings.collection
        assign image = block.settings.image | default: c.featured_image
        assign label = block.settings.label | default: c.title
        assign url = c.url | default: '#'
      -%}
      <li {{ block.shopify_attributes }}>
        <a class="category-tile" href="{{ url }}">
          {%- if image -%}
            {{ image | image_url: width: 1400 | image_tag: sizes: '(min-width: 750px) 50vw, 100vw', widths: '400,700,1000,1400', loading: 'lazy', class: 'category-tile__image' }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}
          {%- endif -%}
          <span class="category-tile__label">{{ label | escape }}</span>
        </a>
      </li>
    {%- endfor -%}
  </ul>
</section>

{% schema %}
{
  "name": "Category grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What are you looking for?" },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Columns on desktop", "default": 2 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Label (defaults to collection title)" },
        { "type": "image_picker", "id": "image", "label": "Image (defaults to collection image)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category grid",
      "blocks": [{ "type": "category" }, { "type": "category" }, { "type": "category" }, { "type": "category" }]
    }
  ]
}
{% endschema %}
