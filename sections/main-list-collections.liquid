<section class="category-grid page-width">
  <h1 class="h1">{{ 'collections.all_title' | t }}</h1>
  <ul class="category-grid__list" style="--columns: 3;">
    {%- for collection in collections -%}
      {%- if collection.products_count > 0 -%}
        <li>
          <a class="category-tile" href="{{ collection.url }}">
            {%- if collection.featured_image -%}
              {{ collection.featured_image | image_url: width: 1000 | image_tag: sizes: '(min-width: 750px) 33vw, 100vw', widths: '400,700,1000', loading: 'lazy', class: 'category-tile__image' }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}
            {%- endif -%}
            <span class="category-tile__label">{{ collection.title | escape }}</span>
          </a>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
</section>

{% schema %}
{
  "name": "Collections list",
  "settings": []
}
{% endschema %}
