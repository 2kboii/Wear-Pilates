<section class="newsletter section-spacing">
  <div class="newsletter__inner page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="h2">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="section-intro__text">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- assign form_id = 'Newsletter-' | append: section.id -%}
    {%- form 'customer', id: form_id, class: 'newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="form-message">{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        {%- if form.errors -%}
          <p class="form-message form-message--error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
        {%- endif -%}
        <div class="newsletter-form__field">
          <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">{{ 'newsletter.email' | t }}</label>
          <input id="NewsletterEmail-{{ section.id }}" type="email" name="contact[email]" placeholder="{{ 'newsletter.email' | t }}" autocomplete="email" required>
          <button type="submit" class="button">{{ 'newsletter.submit' | t }}</button>
        </div>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the Society" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>New drops and studio notes, first.</p>" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
